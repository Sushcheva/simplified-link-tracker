# Copy to .env, then replace the password. Docker Compose loads .env automatically.
DATABASE_NAME=linktracker
DATABASE_USER=linktracker
DATABASE_PASSWORD=replace-with-your-local-password
APP_PORT=8080
RELEASE_VERSION=1.1.0
GITHUB_TOKEN=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=60s
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
